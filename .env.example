# Optional local shell overrides only.
#
# Docker Compose no longer reads this tracked file. Product/runtime settings,
# including GitHub App settings, mail, auth, LLM/MCP, runner defaults, and
# encrypted credential envelopes, are managed from the UI and GitOps.
#
# Use the global config repository as the source of truth:
# - setting/system/runner.yaml
# - setting/system/auth.yaml
# - setting/system/mail.yaml
# - setting/system/llm_profile.yaml
# - setting/system/mcp.yaml
# - setting/system/agent-profiles.yaml
# - setting/system/credentials.yaml
#
# Keep only deployment bootstrap material in your secret manager or shell, for
# example DATABASE_URL, NOPSAI_MASTER_KEY, JWT_SIGNING_KEY,
# SERVICE_JWT_SIGNING_KEY, and AAA_SHARED_INTERNAL_TOKEN.
