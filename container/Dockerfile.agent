ARG BASE_IMAGE=hoseindocker/nopsai-base:latest
FROM ${BASE_IMAGE} AS base
FROM alpine:3.20

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.version="${VERSION}" \
  org.opencontainers.image.revision="${COMMIT}" \
  org.opencontainers.image.created="${BUILD_DATE}"

RUN apk --no-cache add ca-certificates git bash docker-cli yq jq

COPY --from=base /nopsai-agent /usr/local/bin/nopsai-agent

ENTRYPOINT ["nopsai-agent"]
