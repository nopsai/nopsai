FROM golang:1.26.3-alpine AS builder

WORKDIR /src
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY pkg pkg
COPY config config
COPY services services

ENV CGO_ENABLED=0
ENV GOOS=linux
RUN go build -ldflags="-s -w" -o /out/nopsai-agent ./services/agent/cmd/agent

FROM alpine:3.20

RUN apk --no-cache add ca-certificates git bash docker-cli yq jq
COPY --from=builder /out/nopsai-agent /usr/local/bin/nopsai-agent

ENTRYPOINT ["nopsai-agent"]
