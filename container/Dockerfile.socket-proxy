FROM golang:1.26.5 AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG API_VERSION=v1
ARG RUNNER_PROTOCOL_VERSION=1
ARG CLI_COMPATIBILITY=>=0.22.0,<1.0.0
ARG RUNNER_COMPATIBILITY=>=0.22.0,<1.0.0
ARG PLATFORM_COMPATIBILITY=>=0.22.0,<1.0.0
ARG CAPABILITIES=api.v1,cli.api-catalog.v1,config-sync.v1,dashboard-refresh.v1,dashboards.v1,mcp.v1,monitoring.v1,platform.docker-compose,platform.helm,runner.docker,runner.kubernetes,runner.local-registry-auth.v1,runner.registry-auth.v1

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN BUILD_LDFLAGS="-s -w -X nopsai/pkg/buildinfo.Version=${VERSION} -X nopsai/pkg/buildinfo.Commit=${COMMIT} -X nopsai/pkg/buildinfo.BuildDate=${BUILD_DATE} -X nopsai/pkg/buildinfo.APIVersion=${API_VERSION} -X nopsai/pkg/buildinfo.RunnerProtocolVersion=${RUNNER_PROTOCOL_VERSION} -X nopsai/pkg/buildinfo.CLICompatibility=${CLI_COMPATIBILITY} -X nopsai/pkg/buildinfo.RunnerCompatibility=${RUNNER_COMPATIBILITY} -X nopsai/pkg/buildinfo.PlatformCompatibility=${PLATFORM_COMPATIBILITY} -X nopsai/pkg/buildinfo.Capabilities=${CAPABILITIES}" && \
  CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="${BUILD_LDFLAGS}" -o /out/docker-socket-proxy ./services/docker-socket-proxy/cmd/socket-proxy

FROM scratch
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG SOURCE_URL=https://github.com/nopsai/nopsai
LABEL org.opencontainers.image.version="${VERSION}" \
  org.opencontainers.image.revision="${COMMIT}" \
  org.opencontainers.image.created="${BUILD_DATE}" \
  org.opencontainers.image.source="${SOURCE_URL}" \
  org.opencontainers.image.licenses="LicenseRef-NopsAI-Proprietary" \
  org.opencontainers.image.vendor="NopsAI"
COPY --from=builder /out/docker-socket-proxy /docker-socket-proxy
COPY --from=builder /workspace/LICENSE /usr/share/licenses/nopsai/LICENSE
COPY --from=builder /workspace/THIRD_PARTY_NOTICES.md /usr/share/licenses/nopsai/THIRD_PARTY_NOTICES.md
EXPOSE 2375
ENTRYPOINT ["/docker-socket-proxy"]
