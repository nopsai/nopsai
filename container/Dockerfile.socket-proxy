FROM golang:1.26.4 AS builder

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/docker-socket-proxy ./services/docker-socket-proxy/cmd/socket-proxy

FROM scratch
COPY --from=builder /out/docker-socket-proxy /docker-socket-proxy
EXPOSE 2375
ENTRYPOINT ["/docker-socket-proxy"]
