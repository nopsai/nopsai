# Global Settings
LOG_LEVEL="debug"  # Options: "debug", "info", "warn", "error"
LOG_FORMAT="json" # Options: "console", "json"
CONFIG_PATH="/app/config.yml"
NOPSAI_MASTER_KEY="4Ns627gVMolptxqC1tePPpOR3FFr04zi3Lk3iHuEV/g=" # 32bytes random key (openssl rand -base64 32)

# Database
DATABASE_URL="postgres://nopsai_user:yoursecurepassword@nopsai-db:5432/nopsai_db"

# LLM Configuration
GEMINI_API_KEY="AIzaSyCdyZBcvjWrroxGem8l0ER62WNPlg8s7xU"
GEMINI_MODEL="gemini-2.5-flash"

# Service Addresses
NOPSAI_LISTEN_ADDRESS="0.0.0.0:8080"
LLM_AGENT_LISTEN_ADDRESS="0.0.0.0:50051"
GIT_BOT_LISTEN_ADDRESS="0.0.0.0:8081"

# Internal Connection Addresses (for service-to-service communication)
AGENT_LLM_AGENT_ADDRESS="nopsai-llm-agent:50051"
AGENT_NOPSAI_API_URL="http://nopsai:8080"
GIT_BOT_NOPSAI_API_URL="http://nopsai:8080"
NOPSAI_GIT_BOT_API_URL="http://nopsai-git-bot:8081"

# Docker Configuration
DOCKER_NETWORK_NAME="nopsai-net"
AGENT_IMAGE="nopsai-agent:latest"
AUTO_REMOVAL_AGENT_CONTAINER="false"
DEFAULT_PIPELINE_TIMEOUT="30m"
LLM_AGENT_TIMEOUT="2m"

