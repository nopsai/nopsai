# Global Settings
LOG_LEVEL="info"  # Options: "debug", "info", "warn", "error"
LOG_FORMAT="json" # Options: "console", "json"
CONFIG_PATH="/app/config.yml"
CONFIG_REPO_URL="https://github.com/hosein-yousefii/nopsai-config.git"
NOPSAI_MASTER_KEY="4Ns627gVMolptxqC1tePPpOR3FFr04zi3Lk3iHuEV/g=" # 32bytes random key (openssl rand -base64 32)

# Database
DATABASE_URL="postgres://nopsai_user:yoursecurepassword@nopsai-db:5432/nopsai_db"

# LLM Configuration
LLM_PROVIDER="lmstudio"
GEMINI_API_KEY="AIzaSyA3K7w8rHMklM-XAUYKn_kwLRpxXpXmUDU"
GEMINI_MODEL="gemini-2.5-flash"
LMSTUDIO_BASE_URL="http://192.168.1.143:1234"
LMSTUDIO_API_KEY="sk-lm-QQbml0KX:tBpbhRhsCRh3msuOWJKk"
LMSTUDIO_MODEL="qwen/qwen3.5-9b"
LMSTUDIO_ENABLE_THINKING="false"

# Service Addresses
NOPSAI_LISTEN_ADDRESS="0.0.0.0:8080"
GIT_BOT_LISTEN_ADDRESS="0.0.0.0:8081"

# Internal Connection Addresses (for service-to-service communication)
AGENT_NOPSAI_API_URL="http://nopsai:8080"
GIT_BOT_NOPSAI_API_URL="http://nopsai:8080"
NOPSAI_GIT_BOT_API_URL="http://nopsai-git-bot:8081"
DISPATCHER_ADDRESS="dispatcher:9090"
DISPATCHER_LISTEN_ADDRESS="0.0.0.0:9090"
DISPATCHER_ROUTING='{"prod":["runner-prod-1","runner-prod-2"],"*":["runner-general", "runner-general-2"]}'

# Docker Configuration
DOCKER_NETWORK_NAME="nopsai-net"
AGENT_IMAGE="hoseindocker/nopsai-agent:latest"
AUTO_REMOVAL_AGENT_CONTAINER="false"
DEFAULT_PIPELINE_TIMEOUT="30m"
LLM_AGENT_TIMEOUT="2m"

# Dispatcher/Runners
RUNNER_ID="runner-general"
RUNNER_SCOPES="dev,prod"
RUNNER_CAPACITY="2"

AUTH_PROVIDER_LOCAL_ENABLED="true"
JWT_SIGNING_KEY="replace-me"
JWT_ISSUER="nopsai.local"
# JWT_AUDIENCE="nopsai-api"
# IdleTimeoutMinutes="60"

