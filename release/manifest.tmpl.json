{
  "schemaVersion": "v1",
  "version": "{{VERSION}}",
  "chart": {
    "reference": "{{CHART_REFERENCE}}",
    "version": "{{VERSION}}",
    "digest": "sha256:{{CHART_SHA256}}"
  },
  "images": {
    "aaa": "{{AAA_REPOSITORY}}@sha256:{{AAA_IMAGE_SHA256}}",
    "agent": "{{AGENT_REPOSITORY}}@sha256:{{AGENT_IMAGE_SHA256}}",
    "api": "{{API_REPOSITORY}}@sha256:{{API_IMAGE_SHA256}}",
    "dispatcher": "{{DISPATCHER_REPOSITORY}}@sha256:{{DISPATCHER_IMAGE_SHA256}}",
    "dockerSocketProxy": "{{DOCKER_SOCKET_PROXY_REPOSITORY}}@sha256:{{DOCKER_SOCKET_PROXY_IMAGE_SHA256}}",
    "gitBot": "{{GIT_BOT_REPOSITORY}}@sha256:{{GIT_BOT_IMAGE_SHA256}}",
    "k8sRunner": "{{K8S_RUNNER_REPOSITORY}}@sha256:{{K8S_RUNNER_IMAGE_SHA256}}",
    "runner": "{{RUNNER_REPOSITORY}}@sha256:{{RUNNER_IMAGE_SHA256}}",
    "ui": "{{UI_REPOSITORY}}@sha256:{{UI_IMAGE_SHA256}}"
  },
  "compatibility": {
    "cli": ">=2.0.0 <3.0.0",
    "api": "v1",
    "runnerProtocol": 1
  },
  "database": {
    "migrationVersion": 1,
    "rollbackSafe": false,
    "rollbackPolicy": "forward-only"
  },
  "capabilities": [
    "api.v1",
    "cli.api-catalog.v1",
    "config-sync.v1",
    "mcp.v1",
    "monitoring.v1",
    "platform.docker-compose",
    "platform.helm",
    "runner.docker",
    "runner.kubernetes"
  ]
}
